# Full ECR image reference with an immutable tag, preferably the Git commit SHA.
APPLICATION_IMAGE=

POSTGRES_DB_NAME=oven
POSTGRES_USER=oven

# Generate these values on the staging host. Never commit real values.
POSTGRES_PASSWORD=
JWT_SECRET=

# Used only by: docker compose run --rm bootstrap-owner
OVEN_BOOTSTRAP_TENANT_NAME=
OVEN_BOOTSTRAP_OWNER_EMAIL=
OVEN_BOOTSTRAP_OWNER_PASSWORD=

# Use only the hostname in AWS to enable Caddy automatic HTTPS.
# For local validation, use http://localhost.
STAGING_HOSTNAME=
ACME_EMAIL=

# Tenant created by bootstrap-owner and used by authenticated deployment smoke tests.
OVEN_STAGING_TENANT_ID=

# Private storage and public delivery provisioned by Terraform.
AWS_REGION=us-east-1
MEDIA_AWS_BUCKET=
MEDIA_DELIVERY_BASE_URL=

# Cleanup for uploads that were authorized but never confirmed.
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_INITIAL_DELAY=1m
MEDIA_CLEANUP_FIXED_DELAY=1h
MEDIA_PENDING_RETENTION=24h

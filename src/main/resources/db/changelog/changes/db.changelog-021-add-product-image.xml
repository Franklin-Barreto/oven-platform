<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="021-add-product-image" author="franklin">
        <preConditions
                onFail="HALT"
                onFailMessage="Products must be reset before adding the required image_id column">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM products
            </sqlCheck>
        </preConditions>

        <addColumn tableName="products">
            <column name="image_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="products"
                baseColumnNames="image_id"
                referencedTableName="stored_images"
                referencedColumnNames="id"
                constraintName="fk_products_image_id"
                onDelete="RESTRICT"/>

        <createIndex
                tableName="products"
                indexName="idx_products_image_id">
            <column name="image_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
